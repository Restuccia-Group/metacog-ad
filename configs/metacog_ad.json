{
  "//protocol": "The paper's Tables 1 and 2. Both arms run the same brightness augmentation, so the only difference between them is the scorer.",
  "dataset": {
    "name": "mvtec_ad"
  },
  "scale_rule": {
    "scale": 0.625,
    "min_side": 640
  },
  "backbone": "dinov3_vith16plus",
  "layers": [
    7,
    15,
    23,
    31
  ],
  "patch_size": 640,
  "patch_overlap": 128,
  "brightness_augmentation": [
    0.8,
    1.2
  ],
  "threshold_fraction": 8,
  "max_database_size": 100000,
  "subsampling_iterations": 100,
  "threshold_percentile": 95,
  "threshold_factor": 1.421,
  "evaluation_downscale": 4,
  "closing_radius": 26,
  "closing_angles": 16,
  "closing_lower_threshold": 0.8,
  "binary_erosion": 1
}
